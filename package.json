{
  "name": "woolies-mcp",
  "version": "0.1.0",
  "description": "MCP server for shopping the Woolworths New Zealand catalogue: search, product detail, delivery location and cart.",
  "license": "MIT",
  "author": "Adrian Baker",
  "repository": {
    "type": "git",
    "url": "https://github.com/adrian-baker/woolies-mcp"
  },
  "homepage": "https://github.com/adrian-baker/woolies-mcp#readme",
  "bugs": {
    "url": "https://github.com/adrian-baker/woolies-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "woolworths",
    "new-zealand",
    "groceries"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "woolies-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "DESIGN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run check:adjustment && npm run check:session-death",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "login": "tsx scripts/login.ts",
    "deploy": "tsx scripts/deploy.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:account": "tsx scripts/account-smoke.ts",
    "check:stdio": "tsx scripts/stdio-check.ts",
    "check:http": "tsx scripts/http-check.ts",
    "check:login": "tsx scripts/login-probe.ts",
    "check:adjustment": "tsx scripts/adjustment-check.ts",
    "check:session-death": "tsx scripts/session-death-check.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "tough-cookie": "^6.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-functional": "^10.0.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
