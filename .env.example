# Copy to .env and fill in. .env is git-ignored; keep copies of every value in a password manager.

# Unguessable path segment for the HTTP transport. MCP is served only at
# /mcp/$MCP_PATH_TOKEN and every other path 404s. Anyone holding it can read and fill the
# signed-in trolley, so treat it as a credential. Generate with:
#   openssl rand -hex 24
MCP_PATH_TOKEN=

# Set this to serve MCP at /mcp behind OAuth, which is how a hosted client such as claude.ai
# authorises itself: it discovers this server, registers, and sends the person to a consent page.
# The value is the public https origin this deployment answers on — the same host as
# PUBLIC_BASE_URL, with no path, query or fragment. Setting it closes the /mcp/$MCP_PATH_TOKEN
# endpoint, which then serves only the `npm run login` handover.
# MCP_PUBLIC_URL=

# The passphrase typed on that consent page. Required when MCP_PUBLIC_URL is set, minimum 12
# characters. It is the only thing between the internet and the account: use a generated one and
# keep it in a password manager.
# MCP_AUTH_PASSPHRASE=

# Where registered clients and refresh tokens are kept, so a restart does not need another
# approval. Set in docker-compose.yml for the container.
# MCP_OAUTH_FILE=/data/oauth-state.json

# Port the HTTP transport listens on. Defaults to 8480; compose maps it to 127.0.0.1 only.
PORT=8480

# Where the signed-in session is stored so a restart does not need another browser sign-in.
# Set in docker-compose.yml for the container; leave unset for stdio use.
# WOOLIES_SESSION_FILE=/data/session.json

# Deployment target for `npm run deploy`. HOST is an ssh alias; the public URL is only used to
# print the connector address after a deploy.
DEPLOY_SSH_HOST=
DEPLOY_REMOTE_DIR=/volume1/docker/woolies-mcp
PUBLIC_BASE_URL=
# Absolute path to docker on the target. The default suits Synology DSM, which gives non-login
# SSH a minimal PATH; on most hosts `docker` is enough.
# DEPLOY_DOCKER_PATH=docker

# The Woolworths email and password the server signs itself in with when the session dies, as a
# JSON file `{ "email", "password" }`, 0600. Written by `npm run credentials`; set in
# docker-compose.yml for the container. Absent file: automatic sign-in is off. The password is
# never a tool argument and never logged, and it does not belong in this file.
# WOOLIES_CREDENTIALS_FILE=/data/credentials.json
