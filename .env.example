# Copy to .env and fill in. .env is git-ignored; keep copies of every value in a password manager.

# Unguessable path segment for the HTTP transport. MCP is served only at
# /mcp/$MCP_PATH_TOKEN and every other path 404s. Anyone holding it can read and fill the
# signed-in trolley, so treat it as a credential. Generate with:
#   openssl rand -hex 24
MCP_PATH_TOKEN=

# Port the HTTP transport listens on. Defaults to 8480; compose maps it to 127.0.0.1 only.
PORT=8480

# Where the signed-in session is stored so a restart does not need another browser sign-in.
# Set in docker-compose.yml for the container; leave unset for stdio use.
# WOOLIES_SESSION_FILE=/data/session.json

# Deployment target for `npm run deploy`. HOST is an ssh alias; the public URL is only used to
# print the connector address after a deploy.
DEPLOY_SSH_HOST=
DEPLOY_REMOTE_DIR=/volume1/docker/woolies-mcp
PUBLIC_BASE_URL=
# Absolute path to docker on the target. The default suits Synology DSM, which gives non-login
# SSH a minimal PATH; on most hosts `docker` is enough.
# DEPLOY_DOCKER_PATH=docker

# Optional, and usually not usable: a credential sign-in the server can perform itself. Auth0
# serves a captcha to non-browser clients, so this normally fails and `npm run login` is the
# supported path. Never exposed as a tool argument, never logged.
# WOOLIES_EMAIL=
# WOOLIES_PASSWORD=
